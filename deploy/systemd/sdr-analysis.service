# ════════════════════════════════════════════════════════════════════════
#  systemd service unit — AnalysisApp RF Signal Auto-Identification
#
#  Install:
#    sudo cp deploy/systemd/sdr-analysis.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now sdr-analysis
#
#  Logs:
#    journalctl -u sdr-analysis -f
# ════════════════════════════════════════════════════════════════════════

[Unit]
Description=AnalysisApp RF Signal Auto-Identification Service
Documentation=https://github.com/BMichaud7/AnalysisApp
After=network-online.target activemq.service
Wants=network-online.target
# Start after the AMQP broker; restart if it restarts
BindsTo=activemq.service

[Service]
Type=simple
User=sdranalysis
Group=sdranalysis

ExecStart=/usr/local/bin/sdr_analysis --config /etc/sdr-analysis/analysis.xml

# Restart on failure with exponential back-off
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Environment overrides (edit or use /etc/sdr-analysis/env)
EnvironmentFile=-/etc/sdr-analysis/env
Environment=SDR_LOG_LEVEL=info

# Working directory and standard I/O
WorkingDirectory=/var/lib/sdr-analysis
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sdr-analysis

# Resource limits
LimitNOFILE=65536
# Real-time priority for IQ collection thread
LimitRTPRIO=10

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sdr-analysis /var/log/sdr-analysis
# UDP IQ receive ports need AmbientCapabilities=CAP_NET_BIND_SERVICE
# only if using ports < 1024 (not needed for default 20000+ range)

[Install]
WantedBy=multi-user.target
